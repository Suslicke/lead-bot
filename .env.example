# Copy to .env (gitignored) and fill in. Never commit the real .env.
TELEGRAM_BOT_TOKEN=          # @BotFather → /newbot
ALLOWED_TELEGRAM_IDS=        # your id from @userinfobot (comma-separated for several)

# --- LLM provider: cloudflare (Workers AI) | aigateway | anthropic ---
LLM_PROVIDER=aigateway
CLOUDFLARE_ACCOUNT_ID=        # used by cloudflare + aigateway

# aigateway → Claude/GPT/Gemini via AI Gateway (logs/cache/limits in Cloudflare):
AIG_GATEWAY_ID=              # AI Gateway id (dash → AI → AI Gateway)
LLM_API_KEY=                 # the PROVIDER key (Google AI Studio / Anthropic / OpenAI)
CF_AIG_TOKEN=               # optional — only if you enabled gateway authentication
MODEL=google-ai-studio/gemini-2.0-flash   # or anthropic/claude-haiku-4-5, openai/gpt-4o-mini

# cloudflare → Workers AI direct (open models, no provider key):
CLOUDFLARE_API_TOKEN=        # token with Workers AI permission; MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# anthropic → native SDK:
ANTHROPIC_API_KEY=           # set + MODEL=claude-haiku-4-5

# --- Twenty CRM ---
TWENTY_API_KEY=              # Settings → API & Webhooks (deploy fills this from .twenty_key)
TWENTY_API_URL=http://127.0.0.1:4000
TWENTY_PUBLIC_URL=https://crm.suslicketeam.com

# --- 2GIS enrichment (optional) ---
TWOGIS_API_KEY=              # Catalog API key (free demo key works) → paste a 2GIS link, bot auto-fills the lead. Blank = off
# TWOGIS_API_URL=https://catalog.api.2gis.com

# --- misc ---
TZ=Asia/Almaty
SENTRY_DSN=                  # optional — from a project in your self-hosted Sentry; blank = off
# KPI goal + digest times are set live from the bot and persist in ./data/config.json

# ollama -> self-hosted (OpenAI-compat), e.g. behind nginx:
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=https://llm.suslicketeam.com/v1
# LLM_API_KEY=          # optional bearer if the endpoint is protected
# MODEL=qwen2.5:7b
